NODE_ENV=
PORT=
DATABASE_URL=
DOCTORS_API_URL=
POKEMON_API_URL=
OBJECT_STORAGE_URL=
OBJECT_STORAGE_TIMEOUT_MS=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Pool de conexiones a PostgreSQL (recurso del experimento de caos)
DB_POOL_MAX=10
# 0 = sin timeout (Ronda 0). 1000 = falla rapido si no hay conexion (Ronda 1)
DB_POOL_ACQUIRE_TIMEOUT_MS=0

# Degradacion con cache de respaldo: false en Ronda 0, true en Ronda 1
STALE_CACHE_ENABLED=false
STALE_CACHE_TTL_SECONDS=300

# Interruptor de fallos: las rutas /chaos solo existen con CHAOS_ENABLED=true
CHAOS_ENABLED=false
CHAOS_TOKEN=
